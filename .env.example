# Copy this file to `.env.local` and fill in your values.
# Vite only exposes variables prefixed with VITE_.

# Public contact email. Leave empty to hide the email card on the live site.
VITE_CONTACT_EMAIL=

# Path (under /public) or absolute URL of your resume PDF.
VITE_RESUME_PATH=/resume/Selvamurugan_S_Resume.pdf
